{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "compare-live-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
